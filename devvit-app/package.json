{
  "name": "amputatorbot-app",
  "version": "5.0.0",
  "private": true,
  "description": "Detects AMP URLs in comments and posts, replies with the canonical non-AMP link.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "playtest": "devvit playtest",
    "upload": "vite build && devvit upload",
    "check": "tsgo --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@devvit/web": "^0.14.6",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@devvit/start": "^0.14.6",
    "@types/node": "^26.6.3",
    "@typescript/native-preview": "latest",
    "devvit": "0.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.9"
  },
  "license": "GPL-3.0-or-later"
}
